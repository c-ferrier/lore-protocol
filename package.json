{
  "name": "lore-protocol",
  "version": "0.0.0",
  "description": "CLI tool for the Lore protocol — structured decision context in git commits",
  "repository": {
    "type": "git",
    "url": "https://github.com/Ian-stetsenko/lore-protocol"
  },
  "type": "module",
  "bin": {
    "lore": "./bin/lore.js",
    "atom": "./bin/atom.js"
  },
  "files": [
    "bin/",
    "dist/",
    "schemas/",
    "skills/"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src/ tests/",
    "format": "prettier --write src/ tests/",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build && npm run typecheck && npm run test"
  },
  "keywords": [
    "git",
    "cli",
    "lore",
    "decision-records",
    "ai-agents",
    "commit-messages",
    "institutional-knowledge"
  ],
  "author": "Ivan Stetsenko <dev.ivan.stetsenko@gmail.com>",
  "license": "MIT",
  "dependencies": {
    "chalk": "^5.4.1",
    "commander": "^15.0.0",
    "simple-update-notifier": "^2.0.0",
    "smol-toml": "^1.6.1"
  },
  "devDependencies": {
    "@types/node": "^22.13.14",
    "eslint": "^9.23.0",
    "eslint-plugin-simple-import-sort": "^13.0.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "prettier": "^3.5.3",
    "tsdown": "^0.22.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.60.1",
    "vitest": "^4.1.8"
  },
  "allowScripts": {
    "esbuild@0.27.7": true
  }
}
